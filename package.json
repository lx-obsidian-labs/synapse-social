{
  "name": "synapse-social",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "pnpm --filter synapse-web dev",
    "build": "pnpm --filter synapse-web build && pnpm --filter synapse-extension build",
    "lint": "pnpm --filter synapse-web lint",
    "typecheck": "pnpm --filter synapse-web typecheck",
    "test": "pnpm --filter synapse-extension test",
    "test:extension": "pnpm --filter synapse-extension test",
    "ship": "powershell -ExecutionPolicy Bypass -File scripts/ship.ps1"
  },
  "pnpm": {
    "overrides": {
      "react": "18.2.0",
      "react-dom": "18.2.0"
    }
  }
}